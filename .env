# stage2, sites. For setting DNS to aquire TLS certificates.
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN_HERE

# stage3, stacks.authentik. For authentik service.
AUTHENTIK_EMAIL_PASSWORD=your_authentik_email_password_here
AUTHENTIK_SECRET_KEY=your_authentik_secret_key_here
AUTHENTIK_PG_PASS=your_authentik_pg_pass_here

# stage3, stacks.puller. For pulling images from Aiursoft Docker Registry.
PULLER_DOCKER_PASSWORD=YOUR_PULLER_DOCKER_PASSWORD_HERE
PULLER_LOCAL_DOCKER_PASSWORD=YOUR_PULLER_LOCAL_DOCKER_PASSWORD_HERE

# stage4, stacks.clickhouse_outpost. For ClickHouse Outpost service.
CLICKHOUSE_OUTPOST_TOKEN=YOUR_CLICKHOUSE_OUTPOST_TOKEN_HERE
UPTIMEKUMA_OUTPOST_TOKEN=YOUR_UPTIMEKUMA_OUTPOST_TOKEN_HERE

# Stage 4 OIDC settings for various services.
ANDUINOS_BLOG_CLIENT_ID=YOUR_CLIENT_ID_HERE
ANDUINOS_BLOG_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

AOH_CLIENT_ID=YOUR_AOH_CLIENT_ID_HERE
AOH_CLIENT_SECRET=YOUR_AOH_CLIENT_SECRET

TRACER_CLIENT_ID=YOUR_TRACER_CLIENT_ID_HERE
TRACER_CLIENT_SECRET=YOUR_TRACER_CLIENT_SECRET_HERE

GRAFANA_CLIENT_ID=YOUR_GRAFANA_CLIENT_ID_HERE
GRAFANA_CLIENT_SECRET=YOUR_GRAFANA_CLIENT_SECRET_HERE

OPENGIST_CLIENT_ID=YOUR_OPENGIST_CLIENT_ID_HERE
OPENGIST_CLIENT_SECRET=YOUR_OPENGIST_CLIENT_SECRET_HERE